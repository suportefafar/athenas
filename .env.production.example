RAILS_ENV=production
SECRET_KEY_BASE=__REQUIRED__
ADMIN_EMAIL=__REQUIRED__
ADMIN_PASSWORD=__REQUIRED__
APP_BASE_URL=https://athenas.farmacia.ufmg.br
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
SEMANTIC_MIN_SIMILARITY=0.60
