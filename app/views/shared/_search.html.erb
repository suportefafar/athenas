<%= form_with url: search_path, method: :get, class: "search-form", role: "search" do |form| %>
  <%= form.label :q, "Pesquisar nos documentos" %>
  <div class="search-row"><%= form.search_field :q, value: local_assigns[:query], placeholder: "Palavras ou uma frase…", maxlength: 500, required: true %><%= form.submit "Pesquisar" %></div>
<% end %>
