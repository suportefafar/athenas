<%= form_with url: search_path, method: :get, class: "search-form", role: "search" do |form| %>
  <%= form.label :q, "Pesquisar nos documentos", class: "ffds-form-label" %>
  <div class="search-row"><%= form.search_field :q, value: local_assigns[:query], placeholder: "Palavras ou uma frase…", maxlength: 500, required: true, class: "ffds-form-control ffds-form-control-lg" %><%= form.submit "Pesquisar", class: "ffds-btn ffds-btn-primary" %></div>
<% end %>
