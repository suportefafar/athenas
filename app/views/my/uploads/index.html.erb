<h1 class="ffds-h1">Meus uploads</h1><p><%= link_to "Enviar arquivos", new_upload_path, class: "ffds-btn ffds-btn-primary" %></p>
<% if @lots.any? %><%= render "shared/lots", lots: @lots %><% else %><p class="empty">Você ainda não enviou arquivos.</p><% end %>
<%= render "shared/pagination", page: @page, pages: (@total / 20.0).ceil %>
