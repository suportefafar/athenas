<section class="narrow ffds-card ffds-card-accent"><div class="ffds-card-body">
  <h1 class="ffds-h1">Entre no Athenas</h1><p>Consulte o repositório compartilhado da sua equipe.</p>
  <%= form_with url: session_path do |form| %>
    <%= form.label :email_address, "E-mail", class: "ffds-form-label" %><%= form.email_field :email_address, required: true, autocomplete: "username", class: "ffds-form-control" %>
    <%= form.label :password, "Senha", class: "ffds-form-label" %><%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "ffds-form-control" %>
    <%= form.submit "Entrar", class: "ffds-btn ffds-btn-primary" %>
  <% end %>
  <p class="metadata">Precisa de uma conta? Solicite um convite ao administrador.</p>
</div></section>
