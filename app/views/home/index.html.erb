<section class="hero">
  <p class="eyebrow">SEU ACERVO, UMA BUSCA</p>
  <h1>Encontre a informação<br>que você precisa.</h1>
  <p>Pesquise palavras em todos os lotes do Athenas.</p>
  <%= render "shared/search" %>
</section>
