<h1 class="document-title"><%= @lot.name %></h1>
<p><span class="badge <%= @lot.status %>"><%= @lot.status_label %></span></p>
<% if @lot.status == "partial" %><div class="flash alert"><strong>Indexação incompleta.</strong> Parte do conteúdo ou dos embeddings pode não estar pesquisável.</div><% end %>
<% if @lot.processing_error.present? %><p role="alert"><%= @lot.processing_error %></p><% end %>
<% if @lot.processing_warnings.any? %><ul><% @lot.processing_warnings.each do |warning| %><li><%= warning %></li><% end %></ul><% end %>
<dl class="details">
  <dt>Tipo</dt><dd><%= @lot.content_type %></dd>
  <dt>Tamanho</dt><dd><%= number_to_human_size @lot.byte_size %></dd>
  <dt>Origem</dt><dd>Upload</dd>
  <dt>Enviado por</dt><dd><%= @lot.uploader.name %></dd>
  <dt>Data de inclusão</dt><dd><%= l @lot.created_at, format: :long %></dd>
  <% if @lot.page_count %><dt>Páginas</dt><dd><%= @lot.page_count %></dd><% end %>
  <% @lot.metadata.each do |key, value| %><dt><%= key.humanize %></dt><dd><%= value %></dd><% end %>
</dl>
<div class="actions"><%= link_to "Baixar original", download_lot_path(@lot), class: "button", data: { turbo: false } %>
<% if @lot.previewable? %><%= link_to "Pré-visualizar", preview_lot_path(@lot), target: "_blank", rel: "noopener", data: { turbo: false } %><% end %>
<% if @lot.deletable_by?(current_user) %><%= button_to "Excluir lote", lot_path(@lot), method: :delete, class: "danger", form: { data: { turbo_confirm: "Excluir este lote e seu arquivo original? Esta ação não pode ser desfeita." } } %><% end %></div>
