<%= render "shared/search", query: @query %>
<h1>Pesquisar arquivos</h1>
<% if @result %>
  <% if @result.warning %><p class="flash alert" role="status"><%= @result.warning %></p><% end %>
  <p class="metadata"><%= @result.mode == :semantic ? "Resultados por similaridade semântica" : "Resultados por palavras" %> · <%= @result.total %> arquivo(s) encontrado(s)</p>
  <% if @result.lots.any? %><%= render "shared/lots", lots: @result.lots %><% elsif !@result.warning %><p class="empty">Nenhum arquivo encontrado. Tente outras palavras ou uma expressão mais específica.</p><% end %>
  <%= render "shared/pagination", page: @result.page, pages: @result.pages %>
<% else %>
  <p>Pesquise palavras no conteúdo, nome e metadados dos arquivos importados.</p>
  <section class="popular">
    <h2>Mais acessados nos últimos 30 dias</h2>
    <% if @popular.any? %><%= render "shared/lots", lots: @popular %><% else %><p class="empty">Os arquivos mais consultados aparecerão aqui.</p><% end %>
  </section>
<% end %>
