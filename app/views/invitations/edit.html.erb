<section class="narrow"><h1>Defina sua senha</h1><p>Olá, <%= @user.name %>. Use pelo menos 12 caracteres.</p>
  <% if @user.errors.any? %><p role="alert"><%= @user.errors.full_messages.join(". ") %></p><% end %>
  <%= form_with url: invitation_path(params[:token]), method: :patch do |form| %>
    <%= form.label :password, "Nova senha" %><%= form.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %>
    <%= form.label :password_confirmation, "Confirme a senha" %><%= form.password_field :password_confirmation, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %>
    <%= form.submit "Salvar senha" %>
  <% end %>
</section>
