RAILS_ENV=development
DATABASE_URL=postgresql://athenas:example@localhost:55432/athenas_development
TEST_DATABASE_URL=postgresql://athenas:example@localhost:55432/athenas_test
RAILS_MASTER_KEY=
# Em produção, adicione SECRET_KEY_BASE com um valor aleatório seguro.
ADMIN_EMAIL=admin@example.local
# Defina localmente uma senha inicial de pelo menos 12 caracteres.
ADMIN_PASSWORD=
APP_BASE_URL=http://localhost:3000
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# Calibre com consultas reais; 0.60 não garante qualidade.
SEMANTIC_MIN_SIMILARITY=0.60
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_PAGES=100
JOB_CONCURRENCY=1
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.local
